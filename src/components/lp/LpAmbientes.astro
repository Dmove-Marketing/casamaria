---
import Img from '../ui/Img.astro';
interface Props { title: string; text: string; }
const { title, text } = Astro.props;
const fotos = [
  { src: 'espaco/jardim-entrada-vertical.avif', alt: 'Entrada do jardim iluminada à noite' },
  { src: 'espaco/cozinha.avif', alt: 'Cozinha gourmet de apoio' },
  { src: 'espaco/hall-vertical.avif', alt: 'Hall de entrada com piso de madeira' },
  { src: 'espaco/salao-azul-vertical.avif', alt: 'Salão interno com iluminação azul' },
  { src: 'espaco/lounge-poltronas-vertical.avif', alt: 'Lounge com poltronas sob a árvore' },
  { src: 'espaco/banheiro.avif', alt: 'Toalete' },
];
const cards = [
  { icon: 'icones/sala-reuniao.avif', nome: 'Deck<br>para Recepção', desc: 'Área externa ampla, com estrutura de madeira e visual acolhedor, perfeita para criar uma primeira impressão marcante e receber com elegância.' },
  { icon: 'icones/recepcao.avif', nome: 'Sala<br>Interna', desc: 'Espaço climatizado, com acabamentos modernos e iluminação aconchegante, que oferece conforto e sofisticação em qualquer ocasião.' },
  { icon: 'icones/cozinha.avif', nome: 'Cozinha<br>Gourmet', desc: 'Ambiente funcional, equipado para operações profissionais, que proporciona praticidade e agilidade nos bastidores do evento.' },
  { icon: 'icones/flor.avif', nome: 'Jardim', desc: 'Área verde integrada à arquitetura do espaço, com paisagismo planejado e atmosfera tranquila, trazendo leveza e frescor ao ambiente.' },
  { icon: 'icones/bar.avif', nome: 'Bar', desc: 'Estrutura pronta para operação, com bancada, prateleiras e pontos de apoio, combinando praticidade com um toque de descontração.' },
];
---
<section class="lp-amb lp-dark">
  <h2 class="lp-h2" set:html={title} />
  <span class="lp-rule"></span>
  <p class="lp-p">{text}</p>
  <div class="lp-amb__strip" aria-label="Fotos dos ambientes">
    <div class="lp-amb__track">
      {[...fotos, ...fotos].map((f, i) => (
        <Img src={f.src} alt={i < fotos.length ? f.alt : ''} width={500} sizes="(max-width: 768px) 60vw, 20vw" />
      ))}
    </div>
  </div>
  <ul class="lp-amb__cards">
    {cards.map((c) => (
      <li tabindex="0">
        <Img src={c.icon} alt="" width={120} class="lp-amb__icon" />
        <strong set:html={c.nome} />
        <p>{c.desc}</p>
      </li>
    ))}
  </ul>
</section>
