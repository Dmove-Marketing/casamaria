---
import LpVideo from './LpVideo.astro';
interface Props { title: string; videoMode?: 'player' | 'ambiente'; }
const { title, videoMode = 'player' } = Astro.props;
---
<section class="lp-intro">
  <LpVideo file="casa-maria-sobre-720.mp4" poster="casa-maria-sobre-poster.jpg" title="Conheça a Casa Maria Jardins" mode={videoMode} />
  <div class="lp-intro__text">
    <h2 class="lp-h2" set:html={title} />
    <span class="lp-rule"></span>
    <div class="lp-p"><slot /></div>
  </div>
</section>
