---
import Base from '../layouts/Base.astro';
import Img from '../components/ui/Img.astro';
import '../styles/lp.css';
---
<Base title="Página não encontrada | Casa Maria Jardins" noIndex theme="light">
  <main class="lp-page nf">
    <Img src="espaco/jardim-caminho-noite.jpg" alt="" width={1600} class="nf__bg" sizes="100vw" />
    <div class="nf__in">
      <Img src="marca/logo-branca.png" alt="Casa Maria Jardins" width={240} class="nf__logo" sizes="150px" />
      <h1>Esta página não existe mais</h1>
      <p>Mas a Casa Maria continua de portas abertas.</p>
      <nav>
        <a href="/">Página inicial</a>
        <a href="/casamentos/">Casamentos</a>
        <a href="/eventos-corporativos/">Eventos corporativos</a>
      </nav>
    </div>
  </main>
</Base>
<style>
  .nf { position: relative; min-height: 100vh; display: grid; place-items: center; text-align: center; color: #fff; padding: 2rem 1.25rem; }
  .nf :global(.nf__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(.35); }
  .nf__in { position: relative; max-width: 560px; }
  .nf :global(.nf__logo) { width: 150px; height: auto; margin: 0 auto 2rem; }
  .nf h1 { font-size: clamp(2rem, 6vw, 3rem); color: var(--lp-creme-claro); margin: 0 0 .8rem; }
  .nf nav { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; margin-top: 2rem; }
  .nf nav a { color: #fff; border: 1px solid rgba(255,255,255,.5); border-radius: 999px; padding: .7rem 1.4rem; text-decoration: none; font-weight: 600; }
</style>
